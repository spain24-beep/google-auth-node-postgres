# Local development server.
PORT=3000

# Google OAuth 2.0 client ID.
# Used by the backend to verify that Google ID tokens
# were issued for this application.
GOOGLE_CLIENT_ID=

# Failsafe Administrator account.
# This email receives administrator privileges after
# successful Google authentication.
ADMIN_EMAIL=

# Public Google Sheets CSV export URL.
# The spreadsheet is publicly shared, so no service account is needed.
GOOGLE_SHEET_URL=

# PostgreSQL database connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=google_auth_starter
DB_USER=google_auth_starter_app
DB_PASSWORD=

# Database migration account.
# Used only by the migration runner, never by the running application.
MIGRATION_DB_USER=google_auth_starter_migrator
MIGRATION_DB_PASSWORD=

# Session security.
# Generate a unique secret of at least 64 characters for each environment.
SESSION_SECRET=

# Application origin.
# Must match the origin from which the browser accesses the application.
APP_ORIGIN=http://localhost:3000

# Runtime environment.
# Production enables secure HTTPS session cookies.
NODE_ENV=development